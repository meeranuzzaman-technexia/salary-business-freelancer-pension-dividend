+    "DIVIDEND",
+  );
+  // reversal wording wins over the dividend keyword
+  assert.notEqual(
+    classify("DIVIDEND REFUND REVERSAL", { credit: "185000" }).category,
+    "DIVIDEND",
+  );
+  // transfer language wins over the dividend keyword
+  assert.notEqual(
+    classify("FUNDS TRANSFER FROM HBL DIVIDEND ACCOUNT", { credit: "185000" })
+      .category,
+    "DIVIDEND",
+  );
+  // whole-word matching: a glued lookalike is not a dividend
+  assert.notEqual(
+    classify("DIVIDENDAL ADJUSTMENT NOTE", { credit: "185000" }).category,
+    "DIVIDEND",
+  );
+});
+
+test("dividend: auto-approve is gated — source selected + rule re-verified", () => {
+  const source = fs.readFileSync(
+    path.join(root, "app/actions/bank-classification.ts"),
+    "utf8",
+  );
+  const autoFn = source.slice(
+    source.indexOf("autoReviewSafeBankTransactionsAction"),
+  );
+  assert.ok(
+    /dividendEnabled\s*=\s*isDividendIncomeSelected\(draft\)/.test(autoFn),
+    "auto-review must read the filing's dividend source",
+  );
+  assert.ok(
+    /suggestedCategory === "DIVIDEND"[\s\S]*?dividendEnabled[\s\S]*?classifyTransaction\(transaction, \[\], \{\}\)\s*\.category\s*===\s*"DIVIDEND"/.test(
+      autoFn,
+    ),
+    "a DIVIDEND row is bulk-safe only when the source is selected AND the deterministic rule reproduces it",
+  );
+  // the salary/pension whitelist must stay tight — dividend rides its own branch
+  assert.ok(
+    /\["SALARY", "PENSION"\]\.includes/.test(autoFn),
+    "the SALARY/PENSION bulk-safe whitelist must remain intact",
+  );
+});
